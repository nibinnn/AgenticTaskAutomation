# Copy this file to .env and fill in your values
# cp .env.example .env

# Required for AI features (AIAgent, PlannerAgent)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: logging verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Used by the 'solver' service — describe your task here
REQUIREMENT=Analyze my sales data and generate a CSV report with AI insights

# Optional JSON array or object to pass as context data
CONTEXT_JSON=
